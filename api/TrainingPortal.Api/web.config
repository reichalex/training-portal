<?xml version="1.0" encoding="utf-8"?>
<!-- Used when hosting on IIS. dotnet publish adds the ASP.NET Core module settings to this file. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- IIS rejects request bodies over 30 MB by default; allow large video uploads (about 4 GB). -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
